# ── Database (Neon PostgreSQL) ──
# Get a free connection string from https://neon.tech (Pooled connection)
DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname?sslmode=require

# ── Security ──
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-32-byte-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ──
# Comma-separated list of allowed origins (frontend URLs)
# Local dev + your Vercel URL
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Worker ──
# Tick interval for the monitor worker (seconds)
POLL_INTERVAL=15
# Consecutive failures before an incident/alert is opened (reduces false alarms)
FAILURE_THRESHOLD=3
# Retry delay between confirmation checks (seconds)
CONFIRMATION_DELAY=10

# ── Telegram (primary alerts) ──
# Create a bot via @BotFather, then send it a message and get your chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# If empty, prints the alert to stdout instead of sending (great for local dev)

# ── Resend (secondary email alerts, optional) ──
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com
ALERT_TO_EMAIL=

# ── OpenRouter (AI incident explanations, optional) ──
# https://openrouter.ai/keys  — used for "AI Incident Explanation"
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1:free
