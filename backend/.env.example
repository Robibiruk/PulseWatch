# ── PulseWatch backend configuration ──
# Copy to `.env` and fill in. All values here are OPTIONAL unless marked
# (required). The app runs fine locally with the built-in defaults for the rest.

# ── Core ──
# (required) SQLAlchemy async URL: Postgres/Neon or SQLite for local dev.
#   Local:   sqlite+aiosqlite:///./pulsewatch.db
#   Neon:    postgresql+asyncpg://user:pass@host/dbname
DATABASE_URL=sqlite+aiosqlite:///./pulsewatch.db
# JWT signing secret — set a long random value in production.
SECRET_KEY=dev-insecure-change-me
# JWT algorithm + lifetime (minutes).
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Comma-separated allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# ── Worker / scheduler ──
# POLL_INTERVAL=15
# WORKER_CONCURRENCY=20
# Set true to disable the built-in scheduler (e.g. GitHub Actions owns checks).
# NO_WORKER=false
# FAILURE_THRESHOLD=3
# CONFIRMATION_DELAY=10
# SSL_WARN_DAYS=14
# CHECKIN_INTERVAL_MINUTES=1440

# ── Telegram (optional) ──
# Bot token from @BotFather. Enables the bot + Telegram alerts.
# TELEGRAM_BOT_TOKEN=
# Optional global fallback chat id.
# TELEGRAM_CHAT_ID=
# Set true to disable the bot poller.
# NO_TELEGRAM_BOT=false
# Public base URL the bot uses to call back /auth/telegram/connect.
# PUBLIC_BASE_URL=http://localhost:8000

# ── Email (Resend, optional) ──
# Without RESEND_API_KEY emails print to console (dev fallback).
# RESEND_API_KEY=
# ALERT_FROM_EMAIL=alerts@yourdomain.com
# ALERT_TO_EMAIL=

# ── Other alert channels (global fallback; per-user values take precedence) ──
# DISCORD_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
# GENERIC_WEBHOOK_URL=

# ── OpenRouter (AI incident explanations, optional) ──
# https://openrouter.ai/keys  — used for "AI Incident Explanation"
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
